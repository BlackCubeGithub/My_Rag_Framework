# Environment Configuration
# Copy this file to .env and fill in your values

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_LOCAL_PATH=./models/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# Reranker Configuration
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_LOCAL_PATH=./models/bge-reranker-large
RERANKER_TOP_K=20

# Vector Store
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PERSIST_DIR=./data/vector_store
VECTOR_STORE_COLLECTION_NAME=documents

# Document Processing
CHUNK_SIZE=512
CHUNK_OVERLAP=128
CHUNK_STRATEGY=recursive

# Retrieval
RETRIEVAL_TOP_K=10
HYBRID_ALPHA=0.5

# Agentic RAG
MAX_REFLECTION_ROUNDS=3
REFLECTION_THRESHOLD=0.7
VERIFICATION_THRESHOLD=0.8

# Observability
OTEL_SERVICE_NAME=my-rag-framework
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_TRACING=true
ENABLE_METRICS=true

# Debug
DEBUG=true
